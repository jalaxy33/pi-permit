{
  "description": "Everything from basic plus ordinary destructive operations. Expect prompts during normal work.",
  "commands": {
    "ask": [
      {
        "id": "git-add",
        "program": "git",
        "args": [
          "add"
        ],
        "reason": "stages changes"
      },
      {
        "id": "git-commit",
        "program": "git",
        "args": [
          "commit"
        ],
        "reason": "creates a commit"
      },
      {
        "id": "git-push",
        "program": "git",
        "args": [
          "push"
        ],
        "reason": "updates the remote"
      },
      {
        "id": "git-merge",
        "program": "git",
        "args": [
          "merge"
        ],
        "reason": "merges branches"
      },
      {
        "id": "git-reset-hard",
        "program": "git",
        "args": [
          "reset"
        ],
        "allFlags": [
          "--hard"
        ],
        "reason": "discards uncommitted work"
      },
      {
        "id": "git-discard",
        "program": "git",
        "args": [
          "checkout",
          "restore"
        ],
        "argvRegex": "(^|\\s)(--|\\.|-f|--force)(\\s|$)",
        "unlessFlag": [
          "--staged",
          "-p",
          "--patch"
        ],
        "reason": "discards local changes"
      },
      {
        "id": "git-clean",
        "program": "git",
        "args": [
          "clean"
        ],
        "anyFlag": [
          "-f",
          "--force",
          "-d",
          "-x"
        ],
        "reason": "deletes untracked files"
      },
      {
        "id": "git-branch-delete",
        "program": "git",
        "args": [
          "branch"
        ],
        "anyFlag": [
          "-D"
        ],
        "reason": "deletes a branch"
      },
      {
        "id": "git-tag-delete",
        "program": "git",
        "args": [
          "tag"
        ],
        "anyFlag": [
          "-d"
        ],
        "reason": "deletes a tag"
      },
      {
        "id": "git-stash-drop",
        "program": "git",
        "args": [
          "stash"
        ],
        "argvRegex": "(^|\\s)(drop|clear)(\\s|$)",
        "reason": "deletes a stash"
      },
      {
        "id": "git-worktree-remove",
        "program": "git",
        "args": [
          "worktree"
        ],
        "argvRegex": "(^|\\s)remove(\\s|$)",
        "reason": "removes a worktree"
      },
      {
        "id": "rsync-delete",
        "program": "rsync",
        "anyFlag": [
          "--delete",
          "--delete-after"
        ],
        "reason": "deletes destination files"
      },
      {
        "id": "find-delete",
        "program": "find",
        "anyFlag": [
          "-delete"
        ],
        "reason": "bulk delete via find"
      },
      {
        "id": "find-exec-rm",
        "program": "find",
        "argvRegex": "-exec\\s+rm\\b",
        "reason": "bulk delete via find -exec rm"
      },
      {
        "id": "xargs-rm",
        "program": "xargs",
        "argvRegex": "(^|\\s)rm(\\s|$)",
        "reason": "bulk delete via xargs"
      },
      {
        "id": "truncate-zero",
        "program": "truncate",
        "argvRegex": "-s\\s*0|--size=0",
        "reason": "truncates a file"
      },
      {
        "id": "dropdb",
        "program": [
          "dropdb"
        ],
        "reason": "drops a database"
      },
      {
        "id": "redis-flush",
        "program": "redis-cli",
        "argvRegex": "[Ff][Ll][Uu][Ss][Hh](all|ALL|db|DB)",
        "reason": "flushes the database"
      },
      {
        "id": "sql-drop",
        "program": [
          "psql",
          "mysql",
          "mariadb",
          "sqlite3"
        ],
        "anyFlag": [
          "-c",
          "--command",
          "-e",
          "--eval"
        ],
        "argvRegex": "([Dd][Rr][Oo][Pp]|[Tt][Rr][Uu][Nn][Cc][Aa][Tt][Ee])\\s+([Dd][Aa][Tt][Aa][Bb][Aa][Ss][Ee]|[Tt][Aa][Bb][Ll][Ee]|[Ss][Cc][Hh][Ee][Mm][Aa]|[Kk][Ee][Yy][Ss][Pp][Aa][Cc][Ee])",
        "reason": "drops or truncates tables"
      },
      {
        "id": "terraform-apply",
        "program": "terraform",
        "args": [
          "apply",
          "destroy"
        ],
        "reason": "changes infrastructure"
      },
      {
        "id": "kubectl-destructive",
        "program": "kubectl",
        "args": [
          "delete",
          "drain"
        ],
        "reason": "deletes cluster resources"
      },
      {
        "id": "helm-uninstall",
        "program": "helm",
        "args": [
          "uninstall",
          "delete"
        ],
        "reason": "uninstalls a release"
      },
      {
        "id": "docker-prune",
        "program": "docker",
        "argvRegex": "(system\\s+prune|volume\\s+(rm|prune)|compose\\s+down\\b.*-v)",
        "reason": "removes volumes or prunes"
      },
      {
        "id": "publish",
        "program": [
          "npm",
          "pnpm",
          "yarn",
          "cargo",
          "gem"
        ],
        "args": [
          "publish",
          "unpublish",
          "push"
        ],
        "reason": "publishes a package"
      },
      {
        "id": "gh-delete",
        "program": "gh",
        "args": [
          "delete"
        ],
        "reason": "deletes a remote resource"
      }
    ],
    "allow": [
      {
        "id": "git-push-lease",
        "program": "git",
        "args": [
          "push"
        ],
        "argvRegex": "--force-with-lease",
        "reason": "force-with-lease is recoverable"
      }
    ]
  }
}
